{
	"name": "abler-cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Unofficial Abler CLI and MCP server with browser-assisted login and GraphQL access",
	"license": "MIT",
	"author": "Axel Paul Gunnarsson",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axelpaul/abler-cli.git"
	},
	"homepage": "https://github.com/axelpaul/abler-cli#readme",
	"bugs": {
		"url": "https://github.com/axelpaul/abler-cli/issues"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"bin": {
		"abler": "src/index.ts"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"serve": "bun src/index.ts serve",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test",
		"build:login": "bun build --target=node --format=esm --external playwright-core src/login-command.ts --outfile dist/login-helper.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"graphql": "^16.11.0",
		"playwright-core": "^1.55.0",
		"tough-cookie": "^6.0.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/tough-cookie": "^4.0.5",
		"typescript": "^5.6.0"
	}
}
